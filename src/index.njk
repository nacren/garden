---
layout: base.njk
title: ""
---
<section class="intro">
  <h1>{{ site.title }}</h1>
  <p class="tagline">{{ site.tagline }}</p>
  <p>I take text apart to see what a screen, a filter, and a language model each make of it.</p>
</section>

<section id="work">
  <h2>Work</h2>
  <article class="card">
    <h3><a href="https://github.com/nacren/cursed-strings">Cursed Strings</a></h3>
    <p>The code and the raw trial records behind the article.</p>
    <p class="links">
      <a href="https://github.com/nacren/cursed-strings">repository</a>
      <span aria-hidden="true">·</span>
      <a href="/posts/cursed-strings/">article</a>
    </p>
  </article>
</section>

<section id="writing">
  <h2>Writing</h2>
  <ul class="postlist">
  {% for post in collections.posts %}
    <li>
      <a class="title" href="{{ post.url }}">{{ post.data.title }}</a>
      <time class="date" datetime="{{ post.date | date }}">{{ post.date | date }}</time>
      {% if post.data.summary %}<p class="summary">{{ post.data.summary }}</p>{% endif %}
    </li>
  {% endfor %}
  </ul>
</section>

<section id="connect">
  <h2>Connect</h2>
  <p>I'm on <a href="{{ site.github }}">GitHub</a>.</p>
</section>
