---
layout: base.njk
title: ""
---
<section class="intro">
  <h1>{{ site.title }}</h1>
  <p class="tagline">{{ site.tagline }}</p>
</section>
<section id="writing">
  <h2>Writing</h2>
  <ul class="postlist">
  {% for post in collections.posts %}
    <li>
      <a class="title" href="{{ post.url }}">{{ post.data.title }}</a>
      <time class="date" datetime="{{ post.date | date }}">{{ post.date | date }}</time>
      {% if post.data.summary %}<p class="summary">{{ post.data.summary }}</p>{% endif %}
    </li>
  {% endfor %}
  </ul>
</section>
