<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ summary or site.tagline }}">
<meta name="color-scheme" content="dark">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<header class="site">
  <a class="brand" href="/">{{ site.title }}<span class="prompt"> ~$</span></a>
  <nav>
    <a href="/">home</a>
    <a href="/about/">about</a>
    <a href="/keys/">keys</a>
    <a href="/contact/">contact</a>
  </nav>
</header>
<main>
{{ content | safe }}
</main>
<footer class="site">
  {{ site.title }}
</footer>
</body>
</html>
